@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="container error-page reveal">
    <div class="glass-panel error-card">
        <div class="error-code">🎭</div>
        <h1>Something went wrong</h1>
        <p>Our projector jammed. Please try again or head back to the lobby.</p>
        @if (Model.ShowRequestId)
        {
            <p class="muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-gold magnetic"><span class="btn-shine"></span>Back to Movies</a>
    </div>
</section>
