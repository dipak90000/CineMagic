@model ContactViewModel
@{
    ViewData["Title"] = "Contact Us";
    var sent = ViewData["ContactSent"] as bool? == true;
}

<section class="container contact-page">
    <div class="section-head reveal visible">
        <h1 class="section-title">Contact <em>Us</em></h1>
        <p class="section-sub">Questions about bookings, refunds or group shows? We reply within 24 hours.</p>
    </div>

    <div class="contact-layout">
        <!-- ============ FORM ============ -->
        <div class="glass-panel reveal visible">
            @if (sent)
            {
                <div class="contact-success">
                    <div class="confirm-check">✓</div>
                    <h2>Message received!</h2>
                    <p class="muted">Thanks for reaching out — our team will get back to you within 24 hours. 🍿</p>
                </div>
            }
            else
            {
                <h2 class="section-title">Send a <em>Message</em></h2>
                <form asp-controller="Home" asp-action="Contact" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="field floating">
                        <input asp-for="Name" placeholder=" " autocomplete="name" />
                        <label asp-for="Name">Full name</label>
                        <span class="field-bar"></span>
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>

                    <div class="field floating">
                        <input asp-for="Email" placeholder=" " type="email" autocomplete="email" />
                        <label asp-for="Email">Email address</label>
                        <span class="field-bar"></span>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label class="field-static-label" asp-for="Topic">Topic</label>
                        <select asp-for="Topic" class="select-input">
                            <option value="">— Choose a topic —</option>
                            <option>Booking help</option>
                            <option>Refunds &amp; cancellations</option>
                            <option>Group / corporate shows</option>
                            <option>Feedback</option>
                            <option>Something else</option>
                        </select>
                        <span asp-validation-for="Topic" class="field-error"></span>
                    </div>

                    <div class="field floating">
                        <textarea asp-for="Message" placeholder=" " rows="5"></textarea>
                        <label asp-for="Message">Your message</label>
                        <span class="field-bar"></span>
                        <span asp-validation-for="Message" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn btn-gold btn-lg btn-block magnetic ripple">
                        <span class="btn-shine"></span>✉️ Send Message
                    </button>
                </form>
            }
        </div>

        <!-- ============ CINEMA INFO ============ -->
        <aside class="glass-panel reveal visible">
            <h3>Visit the Cinema</h3>
            <div class="info-rows">
                <div class="info-row"><span class="info-icon">📍</span><div><strong>CineMagic Grand</strong><br /><span class="muted">4th Floor, Galaxy Mall, Andheri West,<br />Mumbai 400053</span></div></div>
                <div class="info-row"><span class="info-icon">📞</span><div><strong>+91 98765 43210</strong><br /><span class="muted">10 AM – 11 PM, all days</span></div></div>
                <div class="info-row"><span class="info-icon">✉️</span><div><strong>hello@cinemagic.in</strong><br /><span class="muted">We reply within 24 hours</span></div></div>
                <div class="info-row"><span class="info-icon">🎟️</span><div><strong>Box office</strong><br /><span class="muted">Opens 30 minutes before the first show</span></div></div>
            </div>
        </aside>
    </div>
</section>
